# Supabase Configuration
# Replace with your project values from Supabase dashboard > Settings > API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-web-push-vapid-public-key

# Server-side only (Vercel / deployment environment)
# Either set SUPABASE_URL/SUPABASE_ANON_KEY or rely on VITE_ values above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
VAPID_PRIVATE_KEY=your-web-push-vapid-private-key
VAPID_SUBJECT=mailto:support@yourdomain.com

# Admin Configuration
# Comma-separated list of admin email addresses
VITE_ADMIN_EMAILS=sandeepscodes@gmail.com,admin@smartsplit.com

